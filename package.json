{
  "name": "@forge/web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Forge React workbench for the standalone Web host",
  "type": "module",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:browser": "vitest run tests/web-smoke-browser.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@forge/core": "file:../forge-core",
    "@phosphor-icons/react": "^2.1.7",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.25.3",
    "playwright": "^1.51.1",
    "typescript": "^5.8.3",
    "vite": "^8.3.4",
    "vitest": "^3.1.2"
  }
}
