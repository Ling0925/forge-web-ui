{
  "name": "@forge/web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Forge React workbench for the standalone Web host",
  "type": "module",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "packageManager": "pnpm@11.18.0",
  "imports": {
    "#components/*": "./src/renderer/components/*.tsx",
    "#ui/*": "./src/renderer/components/ui/*.tsx",
    "#lib/*": "./src/renderer/lib/*.ts",
    "#hooks/*": "./src/renderer/hooks/*.ts"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "check:css-vars": "node scripts/check-css-vars.mjs",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:browser": "vitest run tests/web-smoke-browser.test.ts tests/web-dev-browser.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:css && pnpm check:css-vars"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@forge/core": "file:../forge-core",
    "@phosphor-icons/react": "^2.1.7",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-select": "^2.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "^6.1.0",
    "motion": "14.10.1",
    "qrcode": "^1.5.4",
    "radix-ui": "1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.25.3",
    "playwright": "^1.51.1",
    "stylelint": "^16.26.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.4",
    "vitest": "^3.1.2"
  }
}
